.whatwg.org/#registered-observer" id=3D"ref-for-registered-observer=E2=91=
=A1">registered observer</a>).

</p>
   <p class=3D"note" role=3D"note"><a data-link-type=3D"dfn" href=3D"https:=
//dom.spec.whatwg.org/#transient-registered-observer" id=3D"ref-for-transie=
nt-registered-observer=E2=91=A1">Transient registered observers</a> are use=
d to track mutations within
a given <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#conc=
ept-node" id=3D"ref-for-concept-node=E2=91=A0=E2=93=AA=E2=91=A0">node</a>=
=E2=80=99s <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#c=
oncept-tree-descendant" id=3D"ref-for-concept-tree-descendant=E2=91=A8">des=
cendants</a> after <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatw=
g.org/#concept-node" id=3D"ref-for-concept-node=E2=91=A0=E2=93=AA=E2=91=A1"=
>node</a> has been removed so
they do not get lost when <code class=3D"idl"><a data-link-type=3D"idl" hre=
f=3D"https://dom.spec.whatwg.org/#dom-mutationobserverinit-subtree" id=3D"r=
ef-for-dom-mutationobserverinit-subtree=E2=91=A0">subtree</a></code> is set=
 to true on <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#=
concept-node" id=3D"ref-for-concept-node=E2=91=A0=E2=93=AA=E2=91=A2">node</=
a>=E2=80=99s
<a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-tree=
-parent" id=3D"ref-for-concept-tree-parent=E2=91=A1=E2=91=A0">parent</a>.


</p>
