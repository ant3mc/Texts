type=3D"const" data-export=3D"" id=3D"dom-node-document_position_disconnect=
ed"><code>DOCUMENT_POSITION_DISCONNECTED</code></dfn> (1);
=20
    </li><li><dfn class=3D"dfn-paneled idl-code" data-dfn-for=3D"Node" data=
-dfn-type=3D"const" data-export=3D"" id=3D"dom-node-document_position_prece=
ding"><code>DOCUMENT_POSITION_PRECEDING</code></dfn> (2);
=20
    </li><li><dfn class=3D"dfn-paneled idl-code" data-dfn-for=3D"Node" data=
