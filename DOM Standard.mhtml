t-event-listener-list" id=3D"ref-for-eventtarget-event-listener-list">event=
 listener list</a> and is not appended if it has the same
  <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#event-list=
ener-type" id=3D"ref-for-event-listener-type">type</a>, <a data-link-type=
=3D"dfn" href=3D"https://dom.spec.whatwg.org/#event-listener-callback" id=
=3D"ref-for-event-listener-callback=E2=91=A8">callback</a>, and
  <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#event-list=
ener-capture" id=3D"ref-for-event-listener-capture=E2=91=A1">capture</a>.

 </p>
    </dd><dt><code><var>target</var> . <a class=3D"idl-code" data-link-type=
=3D"method" href=3D"https://dom.spec.whatwg.org/#dom-eventtarget-removeeven=
tlistener" id=3D"ref-for-dom-eventtarget-removeeventlistener=E2=91=A1">remo=
veEventListener</a>(<var>type</var>, <var>callback</var> [, <var>options</v=
ar>])</code>
=20
    </dt><dd>
     <p>Removes the <a data-link-type=3D"dfn" href=3D"https://dom.spec.what=
wg.org/#concept-event-listener" id=3D"ref-for-concept-event-listener=E2=91=
=A0=E2=91=A4">event listener</a> in <var>target</var>=E2=80=99s
 <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#eventtarget=
-event-listener-list" id=3D"ref-for-eventtarget-event-listener-list=E2=91=
=A0">event listener list</a> with the same <var>type</var>, <var>callback</=
var>, and
 <var>options</var>.

 </p>
    </dd><dt><code><var>target</var> . <a class=3D"idl-code" data-link-type=
=3D"method" href=3D"https://dom.spec.whatwg.org/#dom-eventtarget-dispatchev=
ent" id=3D"ref-for-dom-eventtarget-dispatchevent=E2=91=A2">dispatchEvent</a=
>(<var>event</var>)</code>
