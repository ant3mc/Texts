n</c-><c- p=3D"">;</c->
    showUserErrorMessage<c- p=3D"">();</c->
  <c- p=3D"">})</c->
  <c- p=3D"">.</c->then<c- p=3D"">(()</c-> <c- p=3D"">=3D&gt;</c-> stopSpin=
ner<c- p=3D"">());</c->

<c- c1=3D"">// =E2=80=A6</c->

controller<c- p=3D"">.</c->abort<c- p=3D"">();</c-></code></pre>
    <p><code>doAmazingness</code> could be implemented as follows:

 </p>
<pre><code class=3D"highlight lang-javascript"><c- a=3D"">function</c-> doA=
mazingness<c- p=3D"">({</c->signal<c- p=3D"">})</c-> <c- p=3D"">{</c->
  <c- k=3D"">return</c-> <c- ow=3D"">new</c-> Promise<c- p=3D"">((</c->reso=
lve<c- p=3D"">,</c-> reject<c- p=3D"">)</c-> <c- p=3D"">=3D&gt;</c-> <c- p=
=3D"">{</c->
    signal<c- p=3D"">.</c->throwIfAborted<c- p=3D"">();</c->

    <c- c1=3D"">// Begin doing amazingness, and call resolve(result) when d=
one.</c->
    <c- c1=3D"">// But also, watch for signals:</c->
    signal<c- p=3D"">.</c->addEventListener<c- p=3D"">(</c-><c- t=3D"">'abo=
rt'</c-><c- p=3D"">,</c-> <c- p=3D"">()</c-> <c- p=3D"">=3D&gt;</c-> <c- p=
=3D"">{</c->
      <c- c1=3D"">// Stop doing amazingness, and:</c->
      reject<c- p=3D"">(</c->signal<c- p=3D"">.</c->reason<c- p=3D"">);</c-=
>
    <c- p=3D"">});</c->
  <c- p=3D"">});</c->
<c- p=3D"">}</c->
</code></pre>
   </div>
   <p>APIs that do not return promises can either react in an equivalent ma=
nner or opt to not surface
the <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom.spec.=
whatwg.org/#abortsignal" id=3D"ref-for-abortsignal=E2=91=A7">AbortSignal</a=
></code>=E2=80=99s <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatw=
g.org/#abortsignal-abort-reason" id=3D"ref-for-abortsignal-abort-reason=E2=
=91=A0">abort reason</a> at all. <code class=3D"idl"><a data-link-type=3D"i=
dl" href=3D"https://dom.spec.whatwg.org/#dom-eventtarget-addeventlistener" =
id=3D"ref-for-dom-eventtarget-addeventlistener=E2=91=A3">addEventListener()=
</a></code> is an
example of an API where the latter made sense.

</p>
   <p>APIs that require more granular control could extend both <code class=
=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom.spec.whatwg.org/#abo=
rtcontroller" id=3D"ref-for-abortcontroller=E2=91=A1">AbortController</a></=
code> and
<code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom.spec.what=
wg.org/#abortsignal" id=3D"ref-for-abortsignal=E2=91=A8">AbortSignal</a></c=
ode> objects according to their needs.


</p>
