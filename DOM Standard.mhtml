om.spec.whatwg.org/#concept-range-start-offset" id=3D"ref-for-concept-range=
-start-offset=E2=91=A3">start offset</a> and set its
   <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-r=
ange-start-node" id=3D"ref-for-concept-range-start-node=E2=91=A2">start nod=
e</a> to <var>node</var>.

   </p>
       </li><li>
        <p>For each <a data-link-type=3D"dfn" href=3D"https://dom.spec.what=
wg.org/#concept-live-range" id=3D"ref-for-concept-live-range=E2=91=A4">live=
 range</a> whose <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.=
org/#concept-range-end-node" id=3D"ref-for-concept-range-end-node=E2=91=A1"=
>end node</a> is <var>currentNode</var>: add
   <var>length</var> to its <a data-link-type=3D"dfn" href=3D"https://dom.s=
pec.whatwg.org/#concept-range-end-offset" id=3D"ref-for-concept-range-end-o=
ffset=E2=91=A3">end offset</a> and set its <a data-link-type=3D"dfn" href=
=3D"https://dom.spec.whatwg.org/#concept-range-end-node" id=3D"ref-for-conc=
ept-range-end-node=E2=91=A2">end node</a> to
   <var>node</var>.

   </p>
       </li><li>
        <p>For each <a data-link-type=3D"dfn" href=3D"https://dom.spec.what=
wg.org/#concept-live-range" id=3D"ref-for-concept-live-range=E2=91=A5">live=
 range</a> whose <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.=
org/#concept-range-start-node" id=3D"ref-for-concept-range-start-node=E2=91=
=A3">start node</a> is <var>currentNode</var>=E2=80=99s
