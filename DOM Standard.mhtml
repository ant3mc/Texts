<c- b=3D"">dictionary</c-> <dfn class=3D"dfn-paneled idl-code" data-dfn-typ=
e=3D"dictionary" data-export=3D"" id=3D"dictdef-addeventlisteneroptions"><c=
ode><c- g=3D"">AddEventListenerOptions</c-></code></dfn> : <a data-link-typ=
e=3D"idl-name" href=3D"https://dom.spec.whatwg.org/#dictdef-eventlistenerop=
tions" id=3D"ref-for-dictdef-eventlisteneroptions=E2=91=A0"><c- n=3D"">Even=
tListenerOptions</c-></a> {
  <a class=3D"idl-code" data-link-type=3D"interface" href=3D"https://webidl=
.spec.whatwg.org/#idl-boolean" id=3D"ref-for-idl-boolean=E2=91=A0=E2=91=A7"=
><c- b=3D"">boolean</c-></a> <dfn class=3D"dfn-paneled idl-code" data-dfn-f=
or=3D"AddEventListenerOptions" data-dfn-type=3D"dict-member" data-export=3D=
"" data-type=3D"boolean" id=3D"dom-addeventlisteneroptions-passive"><code><=
c- g=3D"">passive</c-></code></dfn>;
  <a class=3D"idl-code" data-link-type=3D"interface" href=3D"https://webidl=
.spec.whatwg.org/#idl-boolean" id=3D"ref-for-idl-boolean=E2=91=A0=E2=91=A8"=
><c- b=3D"">boolean</c-></a> <dfn class=3D"dfn-paneled idl-code" data-defau=
lt=3D"false" data-dfn-for=3D"AddEventListenerOptions" data-dfn-type=3D"dict=
-member" data-export=3D"" data-type=3D"boolean" id=3D"dom-addeventlistenero=
ptions-once"><code><c- g=3D"">once</c-></code></dfn> =3D <c- b=3D"">false</=
