ins"><code>DOCUMENT_POSITION_CONTAINS</code></dfn> (8);
=20
    </li><li><dfn class=3D"dfn-paneled idl-code" data-dfn-for=3D"Node" data=
-dfn-type=3D"const" data-export=3D"" id=3D"dom-node-document_position_conta=
ined_by"><code>DOCUMENT_POSITION_CONTAINED_BY</code></dfn> (16, 10 in hexad=
ecimal);
=20
    </li><li><dfn class=3D"dfn-paneled idl-code" data-dfn-for=3D"Node" data=
-dfn-type=3D"const" data-export=3D"" id=3D"dom-node-document_position_imple=
mentation_specific"><code>DOCUMENT_POSITION_IMPLEMENTATION_SPECIFIC</code><=
/dfn> (32, 20 in hexadecimal).

   </li></ul>
   <p>The <dfn class=3D"dfn-paneled idl-code" data-dfn-for=3D"Node" data-df=
n-type=3D"method" data-export=3D"" id=3D"dom-node-comparedocumentposition">=
<code>compareDocumentPosition(<var>other</var>)</code></dfn> method
steps are:

</p>
   <ol>
    <li>
     <p>If <a data-link-type=3D"dfn" href=3D"https://webidl.spec.whatwg.org=
/#this" id=3D"ref-for-this=E2=91=A0=E2=93=AA=E2=91=A5">this</a> is <var>oth=
er</var>, then return zero.

 </p>
    </li><li>
     <p>Let <var>node1</var> be <var>other</var> and <var>node2</var> be <a=
 data-link-type=3D"dfn" href=3D"https://webidl.spec.whatwg.org/#this" id=3D=
"ref-for-this=E2=91=A0=E2=93=AA=E2=91=A6">this</a>.

 </p>
    </li><li>
     <p>Let <var>attr1</var> and <var>attr2</var> be null.

 </p>
    </li><li>
     <p>If <var>node1</var> is an <a data-link-type=3D"dfn" href=3D"https:/=
/dom.spec.whatwg.org/#concept-attribute" id=3D"ref-for-concept-attribute=E2=
=91=A0=E2=91=A0">attribute</a>, then set <var>attr1</var> to <var>node1</va=
r>
 and <var>node1</var> to <var>attr1</var>=E2=80=99s <a data-link-type=3D"df=
n" href=3D"https://dom.spec.whatwg.org/#concept-attribute-element" id=3D"re=
f-for-concept-attribute-element">element</a>.

 </p>
    </li><li>
     <p>If <var>node2</var> is an <a data-link-type=3D"dfn" href=3D"https:/=
/dom.spec.whatwg.org/#concept-attribute" id=3D"ref-for-concept-attribute=E2=
=91=A0=E2=91=A1">attribute</a>:

  </p>
     <ol>
      <li>
       <p>Set <var>attr2</var> to <var>node2</var> and <var>node2</var> to =
<var>attr2</var>=E2=80=99s
   <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-a=
ttribute-element" id=3D"ref-for-concept-attribute-element=E2=91=A0">element=
</a>.

   </p>
      </li><li>
       <p>If <var>attr1</var> and <var>node1</var> are non-null, and <var>n=
ode2</var> is
    <var>node1</var>:

    </p>
       <ol>
        <li>
         <p><a data-link-type=3D"dfn" href=3D"https://infra.spec.whatwg.org=
/#list-iterate" id=3D"ref-for-list-iterate=E2=91=A1=E2=91=A4">For each</a> =
<var>attr</var> of <var>node2</var>=E2=80=99s
      <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concep=
t-element-attribute" id=3D"ref-for-concept-element-attribute=E2=91=A3">attr=
ibute list</a>:

      </p>
         <ol>
          <li>
           <p>If <var>attr</var> <a data-link-type=3D"dfn" href=3D"https://=
dom.spec.whatwg.org/#concept-node-equals" id=3D"ref-for-concept-node-equals=
=E2=91=A2">equals</a> <var>attr1</var>, then return the result of
       adding <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https:/=
/dom.spec.whatwg.org/#dom-node-document_position_implementation_specific" i=
d=3D"ref-for-dom-node-document_position_implementation_specific=E2=91=A0">D=
OCUMENT_POSITION_IMPLEMENTATION_SPECIFIC</a></code> and
       <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom.sp=
ec.whatwg.org/#dom-node-document_position_preceding" id=3D"ref-for-dom-node=
-document_position_preceding=E2=91=A1">DOCUMENT_POSITION_PRECEDING</a></cod=
e>.

       </p>
          </li><li>
           <p>If <var>attr</var> <a data-link-type=3D"dfn" href=3D"https://=
dom.spec.whatwg.org/#concept-node-equals" id=3D"ref-for-concept-node-equals=
=E2=91=A3">equals</a> <var>attr2</var>, then return the result of
       adding <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https:/=
/dom.spec.whatwg.org/#dom-node-document_position_implementation_specific" i=
d=3D"ref-for-dom-node-document_position_implementation_specific=E2=91=A1">D=
OCUMENT_POSITION_IMPLEMENTATION_SPECIFIC</a></code> and
       <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom.sp=
ec.whatwg.org/#dom-node-document_position_following" id=3D"ref-for-dom-node=
-document_position_following=E2=91=A1">DOCUMENT_POSITION_FOLLOWING</a></cod=
e>.
      </p>
         </li></ol>
       </li></ol>
     </li></ol>
    </li><li>
     <p>If <var>node1</var> or <var>node2</var> is null, or <var>node1</var=
>=E2=80=99s <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#=
concept-tree-root" id=3D"ref-for-concept-tree-root=E2=91=A1=E2=91=A4">root<=
/a> is
  not <var>node2</var>=E2=80=99s <a data-link-type=3D"dfn" href=3D"https://=
dom.spec.whatwg.org/#concept-tree-root" id=3D"ref-for-concept-tree-root=E2=
=91=A1=E2=91=A5">root</a>, then return the result of adding
  <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom.spec.wh=
atwg.org/#dom-node-document_position_disconnected" id=3D"ref-for-dom-node-d=
ocument_position_disconnected=E2=91=A1">DOCUMENT_POSITION_DISCONNECTED</a><=
/code>, <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom.s=
pec.whatwg.org/#dom-node-document_position_implementation_specific" id=3D"r=
ef-for-dom-node-document_position_implementation_specific=E2=91=A2">DOCUMEN=
T_POSITION_IMPLEMENTATION_SPECIFIC</a></code>, and
  either <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom.=
spec.whatwg.org/#dom-node-document_position_preceding" id=3D"ref-for-dom-no=
de-document_position_preceding=E2=91=A2">DOCUMENT_POSITION_PRECEDING</a></c=
ode> or <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom.s=
pec.whatwg.org/#dom-node-document_position_following" id=3D"ref-for-dom-nod=
e-document_position_following=E2=91=A2">DOCUMENT_POSITION_FOLLOWING</a></co=
de>, with the
  constraint that this is to be consistent, together.

  </p>
     <p class=3D"note" role=3D"note">Whether to return <code class=3D"idl">=
<a data-link-type=3D"idl" href=3D"https://dom.spec.whatwg.org/#dom-node-doc=
ument_position_preceding" id=3D"ref-for-dom-node-document_position_precedin=
g=E2=91=A3">DOCUMENT_POSITION_PRECEDING</a></code> or
  <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom.spec.wh=
atwg.org/#dom-node-document_position_following" id=3D"ref-for-dom-node-docu=
ment_position_following=E2=91=A3">DOCUMENT_POSITION_FOLLOWING</a></code> is=
 typically implemented via pointer comparison. In
  JavaScript implementations a cached <code class=3D"highlight lang-javascr=
ipt">Math<c- p=3D"">.</c->random<c- p=3D"">()</c-></code> value can
  be used.

 </p>
    </li><li>
     <p>If <var>node1</var> is an <a data-link-type=3D"dfn" href=3D"https:/=
/dom.spec.whatwg.org/#concept-tree-ancestor" id=3D"ref-for-concept-tree-anc=
estor=E2=91=A3">ancestor</a> of <var>node2</var> and <var>attr1</var>
 is null, or <var>node1</var> is <var>node2</var> and <var>attr2</var> is n=
on-null, then return the
 result of adding <code class=3D"idl"><a data-link-type=3D"idl" href=3D"htt=
ps://dom.spec.whatwg.org/#dom-node-document_position_contains" id=3D"ref-fo=
r-dom-node-document_position_contains=E2=91=A1">DOCUMENT_POSITION_CONTAINS<=
/a></code> to <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https:/=
/dom.spec.whatwg.org/#dom-node-document_position_preceding" id=3D"ref-for-d=
om-node-document_position_preceding=E2=91=A4">DOCUMENT_POSITION_PRECEDING</=
a></code>.

 </p>
    </li><li>
     <p>If <var>node1</var> is a <a data-link-type=3D"dfn" href=3D"https://=
dom.spec.whatwg.org/#concept-tree-descendant" id=3D"ref-for-concept-tree-de=
scendant=E2=91=A0=E2=91=A3">descendant</a> of <var>node2</var> and <var>att=
r2</var>
 is null, or <var>node1</var> is <var>node2</var> and <var>attr1</var> is n=
on-null, then return the
 result of adding <code class=3D"idl"><a data-link-type=3D"idl" href=3D"htt=
ps://dom.spec.whatwg.org/#dom-node-document_position_contained_by" id=3D"re=
f-for-dom-node-document_position_contained_by=E2=91=A1">DOCUMENT_POSITION_C=
ONTAINED_BY</a></code> to <code class=3D"idl"><a data-link-type=3D"idl" hre=
f=3D"https://dom.spec.whatwg.org/#dom-node-document_position_following" id=
=3D"ref-for-dom-node-document_position_following=E2=91=A4">DOCUMENT_POSITIO=
N_FOLLOWING</a></code>.

 </p>
    </li><li>
     <p>If <var>node1</var> is <a data-link-type=3D"dfn" href=3D"https://do=
m.spec.whatwg.org/#concept-tree-preceding" id=3D"ref-for-concept-tree-prece=
ding=E2=91=A7">preceding</a> <var>node2</var>, then return
  <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom.spec.wh=
atwg.org/#dom-node-document_position_preceding" id=3D"ref-for-dom-node-docu=
ment_position_preceding=E2=91=A5">DOCUMENT_POSITION_PRECEDING</a></code>.

  </p>
     <p class=3D"note" role=3D"note">Due to the way <a data-link-type=3D"df=
n" href=3D"https://dom.spec.whatwg.org/#concept-attribute" id=3D"ref-for-co=
ncept-attribute=E2=91=A0=E2=91=A2">attributes</a> are handled in this algor=
ithm this results in a
  <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-no=
de" id=3D"ref-for-concept-node=E2=91=A0=E2=91=A2=E2=91=A6">node</a>=E2=80=
=99s <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept=
-attribute" id=3D"ref-for-concept-attribute=E2=91=A0=E2=91=A3">attributes</=
a> counting as <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.or=
g/#concept-tree-preceding" id=3D"ref-for-concept-tree-preceding=E2=91=A8">p=
receding</a> that <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg=
.org/#concept-node" id=3D"ref-for-concept-node=E2=91=A0=E2=91=A2=E2=91=A7">=
node</a>=E2=80=99s
  <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-tr=
ee-child" id=3D"ref-for-concept-tree-child=E2=91=A4=E2=91=A2">children</a>,=
 despite <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#con=
cept-attribute" id=3D"ref-for-concept-attribute=E2=91=A0=E2=91=A4">attribut=
es</a> not <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#c=
oncept-tree-participate" id=3D"ref-for-concept-tree-participate=E2=91=A8">p=
articipating</a> in the same
  <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-tr=
ee" id=3D"ref-for-concept-tree=E2=91=A1=E2=93=AA">tree</a>.

 </p>
    </li><li>
     <p>Return <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https:=
//dom.spec.whatwg.org/#dom-node-document_position_following" id=3D"ref-for-=
dom-node-document_position_following=E2=91=A5">DOCUMENT_POSITION_FOLLOWING<=
/a></code>.
</p>
   </li></ol>
   <p>The <dfn class=3D"dfn-paneled idl-code" data-dfn-for=3D"Node" data-df=
n-type=3D"method" data-export=3D"" id=3D"dom-node-contains"><code>contains(=
<var>other</var>)</code></dfn> method steps are to return
true if <var>other</var> is an <a data-link-type=3D"dfn" href=3D"https://do=
m.spec.whatwg.org/#concept-tree-inclusive-descendant" id=3D"ref-for-concept=
-tree-inclusive-descendant=E2=91=A3">inclusive descendant</a> of <a data-li=
nk-type=3D"dfn" href=3D"https://webidl.spec.whatwg.org/#this" id=3D"ref-for=
-this=E2=91=A0=E2=93=AA=E2=91=A7">this</a>; otherwise false
(including when <var>other</var> is null).

</p>
   <hr>
   <p>To
<dfn class=3D"dfn-paneled" data-dfn-type=3D"dfn" data-export=3D"" data-lt=
=3D"locate a namespace prefix|locating a namespace prefix" id=3D"locate-a-n=
amespace-prefix">locate a namespace prefix</dfn>
for an <var>element</var> using <var>namespace</var>, run these steps:

</p>
   <ol>
    <li>
     <p>If <var>element</var>=E2=80=99s <a data-link-type=3D"dfn" href=3D"h=
ttps://dom.spec.whatwg.org/#concept-element-namespace" id=3D"ref-for-concep=
t-element-namespace=E2=91=A1">namespace</a> is <var>namespace</var> and its
 <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-ele=
ment-namespace-prefix" id=3D"ref-for-concept-element-namespace-prefix=E2=91=
=A1">namespace prefix</a> is non-null, then return its
 <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-ele=
ment-namespace-prefix" id=3D"ref-for-concept-element-namespace-prefix=E2=91=
=A2">namespace prefix</a>.

 </p>
    </li><li>
     <p>If <var>element</var> <a data-link-type=3D"dfn" href=3D"https://dom=
.spec.whatwg.org/#concept-element-attribute-has" id=3D"ref-for-concept-elem=
ent-attribute-has=E2=91=A1">has</a> an <a data-link-type=3D"dfn" href=3D"ht=
tps://dom.spec.whatwg.org/#concept-attribute" id=3D"ref-for-concept-attribu=
te=E2=91=A0=E2=91=A5">attribute</a> whose
 <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-att=
ribute-namespace-prefix" id=3D"ref-for-concept-attribute-namespace-prefix=
=E2=91=A0">namespace prefix</a> is "<code>xmlns</code>" and <a data-link-ty=
pe=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-attribute-value" id=
=3D"ref-for-concept-attribute-value=E2=91=A8">value</a> is
 <var>namespace</var>, then return <var>element</var>=E2=80=99s first such =
<a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-attr=
ibute" id=3D"ref-for-concept-attribute=E2=91=A0=E2=91=A6">attribute</a>=E2=
=80=99s
 <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-att=
ribute-local-name" id=3D"ref-for-concept-attribute-local-name=E2=91=A3">loc=
al name</a>.

