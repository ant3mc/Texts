  <a data-link-type=3D"idl-name" href=3D"https://dom.spec.whatwg.org/#abort=
signal" id=3D"ref-for-abortsignal=E2=91=A0"><c- n=3D"">AbortSignal</c-></a>=
 <dfn class=3D"dfn-paneled idl-code" data-dfn-for=3D"AddEventListenerOption=
s" data-dfn-type=3D"dict-member" data-export=3D"" data-type=3D"AbortSignal"=
 id=3D"dom-addeventlisteneroptions-signal"><code><c- g=3D"">signal</c-></co=
