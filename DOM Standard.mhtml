     </li><li>
      <p>If <var>options</var>["<code class=3D"idl"><a data-link-type=3D"id=
l" href=3D"https://dom.spec.whatwg.org/#dom-mutationobserverinit-attributeo=
ldvalue" id=3D"ref-for-dom-mutationobserverinit-attributeoldvalue=E2=91=A2"=
>attributeOldValue</a></code>"] is true and
