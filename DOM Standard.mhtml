<pre class=3D"def highlight idl">[<a class=3D"idl-code" data-link-type=3D"e=
xtended-attribute" href=3D"https://webidl.spec.whatwg.org/#Exposed" id=3D"r=
ef-for-Exposed=E2=91=A0=E2=91=A8"><c- g=3D"">Exposed</c-></a>=3D<c- n=3D"">=
Window</c->]
<c- b=3D"">interface</c-> <dfn class=3D"dfn-paneled idl-code" data-dfn-type=
=3D"interface" data-export=3D"" id=3D"comment"><code><c- g=3D"">Comment</c-=
></code></dfn> : <a data-link-type=3D"idl-name" href=3D"https://dom.spec.wh=
atwg.org/#characterdata" id=3D"ref-for-characterdata=E2=91=A1=E2=91=A0"><c-=
 n=3D"">CharacterData</c-></a> {
  <a class=3D"idl-code" data-link-type=3D"constructor" href=3D"https://dom.=
