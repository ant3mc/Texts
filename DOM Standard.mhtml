/dfn> (a <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom.=
spec.whatwg.org/#mutationobserver" id=3D"ref-for-mutationobserver=E2=91=A0"=
>MutationObserver</a></code> object) and
<dfn class=3D"dfn-paneled" data-dfn-for=3D"registered observer" data-dfn-ty=
pe=3D"dfn" data-noexport=3D"" id=3D"registered-observer-options">options</d=
