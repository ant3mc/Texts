=3D"https://dom.spec.whatwg.org/#dom-addeventlisteneroptions-passive" id=3D=
"ref-for-dom-addeventlisteneroptions-passive=E2=91=A2">passive</a></code>"]=
.

   </p>
       </li><li>
        <p>If <var>options</var>["<code class=3D"idl"><a data-link-type=3D"=
idl" href=3D"https://dom.spec.whatwg.org/#dom-addeventlisteneroptions-signa=
l" id=3D"ref-for-dom-addeventlisteneroptions-signal=E2=91=A0">signal</a></c=
ode>"] <a data-link-type=3D"dfn" href=3D"https://infra.spec.whatwg.org/#map=
-exists" id=3D"ref-for-map-exists=E2=91=A0">exists</a>, then set <var>signa=
l</var> to
   <var>options</var>["<code class=3D"idl"><a data-link-type=3D"idl" href=
=3D"https://dom.spec.whatwg.org/#dom-addeventlisteneroptions-signal" id=3D"=
ref-for-dom-addeventlisteneroptions-signal=E2=91=A1">signal</a></code>"].
  </p>
