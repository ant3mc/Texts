pec.whatwg.org/#characterdata" id=3D"ref-for-characterdata=E2=91=A1=E2=91=
=A8">CharacterData</a></code>
  <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-no=
de" id=3D"ref-for-concept-node=E2=91=A1=E2=91=A0=E2=91=A7">node</a>:

  </p>
      <ol>
       <li>
        <p>Let <var>clone</var> be a <a data-link-type=3D"dfn" href=3D"http=
s://dom.spec.whatwg.org/#concept-node-clone" id=3D"ref-for-concept-node-clo=
ne=E2=91=A0=E2=93=AA">clone</a> of <var>originalStartNode</var>.

   </p>
       </li><li>
        <p>Set <var>clone</var>=E2=80=99s <a data-link-type=3D"dfn" href=3D=
"https://dom.spec.whatwg.org/#concept-cd-data" id=3D"ref-for-concept-cd-dat=
a=E2=91=A3=E2=93=AA">data</a> to the result of
   <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-c=
d-substring" id=3D"ref-for-concept-cd-substring=E2=91=A4">substringing data=
</a> of <var>originalStartNode</var> with <var>originalStartOffset</var> an=
d
   <var>originalEndOffset</var> =E2=88=92 <var>originalStartOffset</var>.

