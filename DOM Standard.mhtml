ttps://dom.spec.whatwg.org/#node" id=3D"ref-for-node=E2=91=A5=E2=91=A1"><c-=
 n=3D"">Node</c-></a> {
  <a class=3D"idl-code" data-link-type=3D"constructor" href=3D"https://dom.=
spec.whatwg.org/#dom-documentfragment-documentfragment" id=3D"ref-for-dom-d=
ocumentfragment-documentfragment"><c- g=3D"">constructor</c-></a>();
};
