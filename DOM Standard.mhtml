d-substring" id=3D"ref-for-concept-cd-substring=E2=91=A5">substringing data=
</a> of <var>originalStartNode</var> with <var>originalStartOffset</var> an=
d
   <var>originalStartNode</var>=E2=80=99s <a data-link-type=3D"dfn" href=3D=
"https://dom.spec.whatwg.org/#concept-node-length" id=3D"ref-for-concept-no=
de-length=E2=91=A1=E2=91=A1">length</a> =E2=88=92 <var>originalStartOffset<=
/var>.

   </p>
       </li><li>
        <p><a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#c=
oncept-node-append" id=3D"ref-for-concept-node-append=E2=91=A1=E2=91=A0">Ap=
pend</a> <var>clone</var> to <var>fragment</var>.
  </p>
      </li></ol>
     </li><li>
      <p>Otherwise, if <var>firstPartiallyContainedChild</var> is non-null:

  </p>
      <ol>
       <li>
        <p>Let <var>clone</var> be a <a data-link-type=3D"dfn" href=3D"http=
s://dom.spec.whatwg.org/#concept-node-clone" id=3D"ref-for-concept-node-clo=
ne=E2=91=A0=E2=91=A1">clone</a> of
   <var>firstPartiallyContainedChild</var>.

   </p>
       </li><li>
        <p><a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#c=
oncept-node-append" id=3D"ref-for-concept-node-append=E2=91=A1=E2=91=A1">Ap=
pend</a> <var>clone</var> to <var>fragment</var>.

   </p>
       </li><li>
        <p>Let <var>subrange</var> be a new <a data-link-type=3D"dfn" href=
=3D"https://dom.spec.whatwg.org/#concept-live-range" id=3D"ref-for-concept-=
live-range=E2=91=A3=E2=93=AA">live range</a> whose <a data-link-type=3D"dfn=
" href=3D"https://dom.spec.whatwg.org/#concept-range-start" id=3D"ref-for-c=
oncept-range-start=E2=91=A1=E2=91=A4">start</a> is
   (<var>originalStartNode</var>, <var>originalStartOffset</var>) and whose=
 <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-ran=
ge-end" id=3D"ref-for-concept-range-end=E2=91=A1=E2=91=A4">end</a> is
   (<var>firstPartiallyContainedChild</var>, <var>firstPartiallyContainedCh=
ild</var>=E2=80=99s
   <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-n=
ode-length" id=3D"ref-for-concept-node-length=E2=91=A1=E2=91=A2">length</a>=
