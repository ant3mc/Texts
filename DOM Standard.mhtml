tps://dom.spec.whatwg.org/#concept-attribute-value" id=3D"ref-for-concept-a=
ttribute-value=E2=91=A5">value</a>.

=20
    </dd><dt><code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://=
dom.spec.whatwg.org/#characterdata" id=3D"ref-for-characterdata=E2=91=A0=E2=
=91=A3">CharacterData</a></code>
=20
    </dt><dd><var>node</var>=E2=80=99s <a data-link-type=3D"dfn" href=3D"ht=
tps://dom.spec.whatwg.org/#concept-cd-data" id=3D"ref-for-concept-cd-data=
=E2=91=A4">data</a>.

=20
    </dd><dt>Otherwise
=20
    </dt><dd>Null.

   </dd></dl>
   <p>The <dfn class=3D"dfn-paneled idl-code" data-dfn-for=3D"Node" data-df=
n-type=3D"attribute" data-export=3D"" id=3D"dom-node-textcontent"><code>tex=
tContent</code></dfn> getter steps are to
return the result of running <a data-link-type=3D"dfn" href=3D"https://dom.=
spec.whatwg.org/#get-text-content" id=3D"ref-for-get-text-content">get text=
 content</a> with <a data-link-type=3D"dfn" href=3D"https://webidl.spec.wha=
twg.org/#this" id=3D"ref-for-this=E2=91=A8=E2=91=A8">this</a>.

</p>
   <p>To <dfn class=3D"dfn-paneled" data-dfn-type=3D"dfn" data-export=3D"" =
id=3D"string-replace-all">string replace all</dfn> with a string <var>strin=
g</var> within a
<a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-node=
" id=3D"ref-for-concept-node=E2=91=A0=E2=91=A1=E2=91=A6">node</a> <var>pare=
nt</var>, run these steps:

</p>
   <ol>
    <li>
     <p>Let <var>node</var> be null.

 </p>
    </li><li>
     <p>If <var>string</var> is not the empty string, then set <var>node</v=
ar> to the result of
 <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#create-a-te=
xt-node" id=3D"ref-for-create-a-text-node=E2=91=A0">creating a text node</a=
> given <var>parent</var>=E2=80=99s <a data-link-type=3D"dfn" href=3D"https=
://dom.spec.whatwg.org/#concept-node-document" id=3D"ref-for-concept-node-d=
ocument=E2=91=A1=E2=91=A4">node document</a> and
 <var>string</var>.

 </p>
    </li><li>
     <p><a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#conc=
ept-node-replace-all" id=3D"ref-for-concept-node-replace-all=E2=91=A0">Repl=
ace all</a> with <var>node</var> within <var>parent</var>.
</p>
   </li></ol>
   <p>To <dfn class=3D"dfn-paneled" data-dfn-type=3D"dfn" data-export=3D"" =
id=3D"set-text-content">set text content</dfn> with a <a data-link-type=3D"=
dfn" href=3D"https://dom.spec.whatwg.org/#concept-node" id=3D"ref-for-conce=
pt-node=E2=91=A0=E2=91=A1=E2=91=A7">node</a> <var>node</var> and a string <=
var>value</var>,
do as defined below, switching on the interface <var>node</var> <a data-lin=
k-type=3D"dfn" href=3D"https://webidl.spec.whatwg.org/#implements" id=3D"re=
f-for-implements=E2=91=A8">implements</a>:

</p>
   <dl class=3D"switch">
    <dt><code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom.s=
pec.whatwg.org/#documentfragment" id=3D"ref-for-documentfragment=E2=91=A0=
=E2=91=A8">DocumentFragment</a></code>
=20
    </dt><dt><code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://=
dom.spec.whatwg.org/#element" id=3D"ref-for-element=E2=91=A2=E2=91=A4">Elem=
ent</a></code>
=20
    </dt><dd>
     <p><a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#stri=
ng-replace-all" id=3D"ref-for-string-replace-all">String replace all</a> wi=
th <var>value</var> within <var>node</var>.

 </p>
    </dd><dt><code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://=
dom.spec.whatwg.org/#attr" id=3D"ref-for-attr=E2=91=A0=E2=91=A1">Attr</a></=
code>
=20
    </dt><dd>
     <p><a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#set-=
an-existing-attribute-value" id=3D"ref-for-set-an-existing-attribute-value=
=E2=91=A0">Set an existing attribute value</a> with <var>node</var> and <va=
r>value</var>.

 </p>
    </dd><dt><code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://=
dom.spec.whatwg.org/#characterdata" id=3D"ref-for-characterdata=E2=91=A0=E2=
=91=A4">CharacterData</a></code>
=20
    </dt><dd>
     <p><a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#conc=
ept-cd-replace" id=3D"ref-for-concept-cd-replace=E2=91=A1">Replace data</a>=
 of <var>node</var> with 0, <var>node</var>=E2=80=99s <a data-link-type=3D"=
dfn" href=3D"https://dom.spec.whatwg.org/#concept-node-length" id=3D"ref-fo=
r-concept-node-length=E2=91=A1">length</a>, and
 <var>value</var>.

 </p>
    </dd><dt>Otherwise
=20
    </dt><dd>
     <p>Do nothing.
</p>
   </dd></dl>
   <p>The <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom=
.spec.whatwg.org/#dom-node-textcontent" id=3D"ref-for-dom-node-textcontent=
=E2=91=A0">textContent</a></code> setter steps are to, if the given value i=
s null, act as if it was the
empty string instead, and then run <a data-link-type=3D"dfn" href=3D"https:=
//dom.spec.whatwg.org/#set-text-content" id=3D"ref-for-set-text-content">se=
t text content</a> with <a data-link-type=3D"dfn" href=3D"https://webidl.sp=
ec.whatwg.org/#this" id=3D"ref-for-this=E2=91=A0=E2=93=AA=E2=93=AA">this</a=
> and the given value.

</p>
   <hr>
   <dl class=3D"domintro">
    <dt><code><var>node</var> . <code class=3D"idl"><a data-link-type=3D"id=
l" href=3D"https://dom.spec.whatwg.org/#dom-node-normalize" id=3D"ref-for-d=
om-node-normalize=E2=91=A0">normalize()</a></code></code>
=20
    </dt><dd>Removes <a data-link-type=3D"dfn" href=3D"https://dom.spec.wha=
twg.org/#concept-node-empty" id=3D"ref-for-concept-node-empty">empty</a> <a=
 data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#exclusive-text=
-node" id=3D"ref-for-exclusive-text-node=E2=91=A3">exclusive <code>Text</co=
