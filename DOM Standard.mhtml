or-documentfragment=E2=91=A4">DocumentFragment</a></code>, <code class=3D"i=
dl"><a data-link-type=3D"idl" href=3D"https://dom.spec.whatwg.org/#document=
type" id=3D"ref-for-documenttype=E2=91=A4">DocumentType</a></code>, <code c=
lass=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom.spec.whatwg.org/=
#element" id=3D"ref-for-element=E2=91=A0=E2=91=A2">Element</a></code>, or
 <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom.spec.wha=
twg.org/#characterdata" id=3D"ref-for-characterdata=E2=91=A4">CharacterData=
</a></code> <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#=
concept-node" id=3D"ref-for-concept-node=E2=91=A2=E2=91=A7">node</a>, then =
<a data-link-type=3D"dfn" href=3D"https://webidl.spec.whatwg.org/#dfn-throw=
" id=3D"ref-for-dfn-throw=E2=91=A0=E2=91=A1">throw</a> a
 "<code class=3D"idl"><a class=3D"idl-code" data-link-type=3D"exception" hr=
ef=3D"https://webidl.spec.whatwg.org/#hierarchyrequesterror" id=3D"ref-for-=
hierarchyrequesterror=E2=91=A1">HierarchyRequestError</a></code>" <code cla=
ss=3D"idl"><a data-link-type=3D"idl" href=3D"https://webidl.spec.whatwg.org=
/#idl-DOMException" id=3D"ref-for-idl-DOMException=E2=91=A0=E2=91=A7">DOMEx=
ception</a></code>.

 </p>
     </li><li>
      <p>If <var>parent</var> is not a <a data-link-type=3D"dfn" href=3D"ht=
tps://dom.spec.whatwg.org/#concept-document" id=3D"ref-for-concept-document=
=E2=91=A7">document</a>:

  </p>
      <ol>
       <li>
        <p>If <var>node</var> is a <a data-link-type=3D"dfn" href=3D"https:=
//dom.spec.whatwg.org/#concept-doctype" id=3D"ref-for-concept-doctype=E2=91=
=A0">doctype</a>, then <a data-link-type=3D"dfn" href=3D"https://webidl.spe=
c.whatwg.org/#dfn-throw" id=3D"ref-for-dfn-throw=E2=91=A0=E2=91=A2">throw</=
a> a
   "<code class=3D"idl"><a class=3D"idl-code" data-link-type=3D"exception" =
href=3D"https://webidl.spec.whatwg.org/#hierarchyrequesterror" id=3D"ref-fo=
r-hierarchyrequesterror=E2=91=A2">HierarchyRequestError</a></code>" <code c=
lass=3D"idl"><a data-link-type=3D"idl" href=3D"https://webidl.spec.whatwg.o=
rg/#idl-DOMException" id=3D"ref-for-idl-DOMException=E2=91=A0=E2=91=A8">DOM=
Exception</a></code>.

   </p>
       </li><li>
        <p>Return.
  </p>
      </li></ol>
     </li><li>
      <p>If <var>node</var> is a <code class=3D"idl"><a data-link-type=3D"i=
dl" href=3D"https://dom.spec.whatwg.org/#text" id=3D"ref-for-text=E2=91=A7"=
>Text</a></code> <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.=
org/#concept-node" id=3D"ref-for-concept-node=E2=91=A2=E2=91=A8">node</a>, =
then <a data-link-type=3D"dfn" href=3D"https://webidl.spec.whatwg.org/#dfn-=
throw" id=3D"ref-for-dfn-throw=E2=91=A0=E2=91=A3">throw</a> a
 "<code class=3D"idl"><a class=3D"idl-code" data-link-type=3D"exception" hr=
