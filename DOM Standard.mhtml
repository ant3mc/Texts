=3D"EventListener" data-dfn-type=3D"method" data-export=3D"" data-lt=3D"han=
dleEvent(event)" id=3D"dom-eventlistener-handleevent"><code><c- g=3D"">hand=
leEvent</c-></code></dfn>(<a data-link-type=3D"idl-name" href=3D"https://do=
m.spec.whatwg.org/#event" id=3D"ref-for-event=E2=91=A0=E2=91=A4"><c- n=3D""=
>Event</c-></a> <dfn class=3D"dfn-paneled idl-code" data-dfn-for=3D"EventLi=
stener/handleEvent(event)" data-dfn-type=3D"argument" data-export=3D"" id=
=3D"dom-eventlistener-handleevent-event-event"><code><c- g=3D"">event</c-><=
/code></dfn>);
};

<c- b=3D"">dictionary</c-> <dfn class=3D"dfn-paneled idl-code" data-dfn-typ=
e=3D"dictionary" data-export=3D"" id=3D"dictdef-eventlisteneroptions"><code=
><c- g=3D"">EventListenerOptions</c-></code></dfn> {
  <a class=3D"idl-code" data-link-type=3D"interface" href=3D"https://webidl=
.spec.whatwg.org/#idl-boolean" id=3D"ref-for-idl-boolean=E2=91=A0=E2=91=A6"=
><c- b=3D"">boolean</c-></a> <dfn class=3D"dfn-paneled idl-code" data-defau=
lt=3D"false" data-dfn-for=3D"EventListenerOptions" data-dfn-type=3D"dict-me=
mber" data-export=3D"" data-type=3D"boolean" id=3D"dom-eventlisteneroptions=
-capture"><code><c- g=3D"">capture</c-></code></dfn> =3D <c- b=3D"">false</=
c->;
