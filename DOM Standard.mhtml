     </li><li>
      <p>If <var>options</var>["<code class=3D"idl"><a data-link-type=3D"id=
l" href=3D"https://dom.spec.whatwg.org/#dom-mutationobserverinit-attributef=
ilter" id=3D"ref-for-dom-mutationobserverinit-attributefilter=E2=91=A2">att=
ributeFilter</a></code>"] <a data-link-type=3D"dfn" href=3D"https://infra.s=
