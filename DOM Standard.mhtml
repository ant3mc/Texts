twg.org/#concept-traversal-root" id=3D"ref-for-concept-traversal-root=E2=91=
=A0=E2=91=A5">root</a> or <var>node</var>=E2=80=99s
   <a data-link-type=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-t=
ree-parent" id=3D"ref-for-concept-tree-parent=E2=91=A5=E2=91=A6">parent</a>=
 is null, then return null.

   </p>
       </li><li>
        <p>Set <var>node</var> to <var>node</var>=E2=80=99s <a data-link-ty=
pe=3D"dfn" href=3D"https://dom.spec.whatwg.org/#concept-tree-parent" id=3D"=
ref-for-concept-tree-parent=E2=91=A5=E2=91=A7">parent</a>.

   </p>
       </li><li>
        <p>If the return value of <a data-link-type=3D"dfn" href=3D"https:/=
/dom.spec.whatwg.org/#concept-node-filter" id=3D"ref-for-concept-node-filte=
r=E2=91=A6">filtering</a> <var>node</var> within <a data-link-type=3D"dfn" =
href=3D"https://webidl.spec.whatwg.org/#this" id=3D"ref-for-this=E2=91=A2=
=E2=91=A2=E2=91=A2">this</a> is
   <code class=3D"idl"><a data-link-type=3D"idl" href=3D"https://dom.spec.w=
hatwg.org/#dom-nodefilter-filter_accept" id=3D"ref-for-dom-nodefilter-filte=
